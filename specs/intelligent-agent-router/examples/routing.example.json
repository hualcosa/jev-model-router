{
  "schema_version": 1,
  "mode": "disabled",
  "consent": {
    "synthetic_tasks": false,
    "real_tasks": false
  },
  "classification": {
    "provider": "typesafe_jev",
    "credential_env": "TYPESAFE_API_KEY",
    "deadline_ms": 2500,
    "retry_count": 0,
    "minimize_task_payload": true,
    "send_full_transcript": false
  },
  "root": {
    "preserve_model": true,
    "preserve_effort": true,
    "warning_once_per_task": true,
    "material_gain_only": true
  },
  "workers": {
    "route_unpinned_only": true,
    "preserve_explicit_model": true,
    "preserve_explicit_effort": true,
    "preserve_custom_or_unknown_profile": true,
    "allow_verified_generic_type": true
  },
  "policy": {
    "target_versions": {
      "claude": {
        "sonnet": "5.5",
        "opus": "5.5",
        "fable": "5.1"
      },
      "codex": {
        "luna": "6",
        "terra": "6",
        "sol": "6.1",
        "astra": "6"
      }
    },
    "frontier_auto_opt_in": false,
    "min_confidence_for_auto": 0.75,
    "allow_implicit_version_substitution": false,
    "require_verified_runtime_mapping": true
  },
  "observability": {
    "log_decisions": true,
    "record_raw_prompt": false,
    "private_state_permissions": true
  }
}
